# PostgreSQL connection used by the app and migrations
DATABASE_URL=postgres://user:password@host:5432/database

# Transactional email through Resend (https://resend.com).
# Both values are required for real email delivery. Leave them empty to keep
# recording notifications without sending; delivery is never simulated.
RESEND_API_KEY=
EMAIL_FROM="Glorified Library <notifications@your-domain.example>"

# Shared secret for GET/POST /api/notifications/run.
# Vercel Cron sends CRON_SECRET as a Bearer token automatically.
CRON_SECRET=
# Alternative for external schedulers.
NOTIFICATION_CRON_SECRET=

# One-time token required to create the first Super Administrator at /setup.
# The setup page is disabled automatically once any user exists.
AUTH_SETUP_TOKEN=

# Absolute base URL used in password-reset links, e.g. https://library.example
APP_URL=http://localhost:3000
