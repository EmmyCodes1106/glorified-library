# PostgreSQL connection used by the app and migrations
DATABASE_URL=postgres://user:password@host:5432/database

# Transactional email through a Gmail account using an App Password.
# Enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 characters here.
# EMAIL_FROM must be the same Gmail address. Leave empty to record
# notifications without sending; delivery is never simulated.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-character-app-password
EMAIL_FROM="Glorified Library <you@gmail.com>"

# Shared secret for GET/POST /api/notifications/run.
# Vercel Cron sends CRON_SECRET as a Bearer token automatically.
CRON_SECRET=
# Alternative for external schedulers.
NOTIFICATION_CRON_SECRET=

# One-time token required to create the first Super Administrator at /setup.
# The setup page is disabled automatically once any user exists.
AUTH_SETUP_TOKEN=

# Absolute base URL used in password-reset links, e.g. https://library.example
APP_URL=http://localhost:3000
